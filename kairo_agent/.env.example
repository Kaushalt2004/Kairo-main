# Kairo Agent to AWS Cloud Connection Configuration
# Replace <YOUR_AWS_EC2_IP_OR_DOMAIN> with your AWS instance public IP or domain name
# Example: ws://3.15.22.45:8000 or wss://api.kairo-mobility.com

KAIRO_CLOUD_WS_URL=ws://<YOUR_AWS_EC2_IP_OR_DOMAIN>:8000
KAIRO_VEHICLE_ID=KAIRO-001
KAIRO_API_KEY=kairo_live_vehicle_kairo_001_key_secret_123
KAIRO_ADAPTER_TYPE=apollo
KAIRO_TELEMETRY_RATE_HZ=10.0

# Apollo 9 Cyber RT Settings
APOLLO_CONTAINER_NAME=apollo_dev_kairo_it37
APOLLO_API_URL=http://127.0.0.1:8000
APOLLO_BRIDGE_HOST=127.0.0.1
APOLLO_BRIDGE_PORT=9090

# Local offline SQLite buffer (stores packets during network dropouts)
OFFLINE_QUEUE_PATH=kairo_offline_queue.db
