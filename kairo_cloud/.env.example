# Environment Configuration for Kairo Cloud Backend
PROJECT_NAME=Kairo Cloud
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=kairo-insecure-dev-secret-key-change-in-production-987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kairo
POSTGRES_PASSWORD=kairo_password
POSTGRES_DB=kairo_db
# Async connection URL format: postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://kairo:kairo_password@localhost:5432/kairo_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["*"]

# Ingestion Settings
TELEMETRY_SAMPLE_RATE_HZ=10
DB_PERSIST_INTERVAL_SECONDS=1.0
VEHICLE_OFFLINE_THRESHOLD_SECONDS=10.0
